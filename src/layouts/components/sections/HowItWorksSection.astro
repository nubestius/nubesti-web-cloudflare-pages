---
import { getLocaleUrlCTM } from "@/lib/utils/languageParser.ts";
import { getTrustBundle } from "@/lib/trust";

const locale = Astro.currentLocale || "en";
const copy = getTrustBundle(locale).howItWorks;
const moreUrl = getLocaleUrlCTM("/how-it-works/", locale);
---

<section id="how-it-works" class="legal-hub !pb-8 !pt-8 md:!pt-12">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-secondary text-sm font-medium tracking-[0.22em] uppercase">
        {copy.eyebrow}
      </p>
      <h2 class="font-secondary text-light mt-4 text-4xl md:text-5xl">
        {copy.title}
      </h2>
      <p class="mt-5 text-lg opacity-75">{copy.intro}</p>
    </div>
    <ol class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        copy.steps.map((item) => (
          <li class="border-white/10 bg-white/[0.035] flex flex-col rounded-3xl border p-7">
            <p class="text-secondary text-xs tracking-[0.2em] uppercase">{item.step}</p>
            <h3 class="font-secondary text-light mt-4 text-2xl">{item.title}</h3>
            <p class="mt-3 flex-1 text-[0.975rem] leading-relaxed opacity-75">
              {item.body}
            </p>
          </li>
        ))
      }
    </ol>
    <p class="mt-10 text-center">
      <a class="text-secondary underline-offset-4 hover:underline" href={moreUrl}>
        {copy.eyebrow} →
      </a>
    </p>
  </div>
</section>
