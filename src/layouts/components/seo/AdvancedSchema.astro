---
import { organizationJsonLd } from "@/lib/schema/organization";
import { COMPANY } from "@/lib/company";

const organizationSchema = organizationJsonLd();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: COMPANY.name,
  url: COMPANY.website,
  description:
    "Continuous autonomous security testing against customer-authorized assets.",
  publisher: {
    "@type": "Organization",
    name: COMPANY.legalName,
    legalName: COMPANY.legalName,
  },
  inLanguage: ["en", "es", "fr", "pt"],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Autonomous security testing",
  description:
    "Repeatable offensive testing of customer-authorized web, API, and cloud assets, with evidence and retest.",
  provider: {
    "@type": "Organization",
    name: COMPANY.legalName,
    legalName: COMPANY.legalName,
  },
  serviceType: "Security testing",
  areaServed: "Worldwide",
};

const schemas = [organizationSchema, websiteSchema, serviceSchema];
---

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
