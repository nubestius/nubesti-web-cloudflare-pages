---
import { getCollection } from "astro:content";

interface FAQSchemaProps {
  faqData?: any[];
}

const { faqData } = Astro.props as FAQSchemaProps;

let faqQuestions = faqData || [];

if (!faqQuestions.length) {
  try {
    const currentLang = Astro.currentLocale || "en";
    const langFolder =
      currentLang === "en" || currentLang === "english" ? "english" : currentLang;
    const faqCollection = await getCollection("faq", (entry) =>
      entry.id.includes(`${langFolder}/`),
    );
    if (faqCollection.length > 0) {
      const list = faqCollection[0].data.list || [];
      faqQuestions = list.flatMap((section: any) =>
        (section.list || []).map((item: any) => ({
          question: item.title,
          answer: item.content,
        })),
      );
    }
  } catch {
    faqQuestions = [];
  }
}

const mainEntity = (faqQuestions || [])
  .filter((item: any) => item.question || item.title)
  .slice(0, 12)
  .map((item: any) => ({
    "@type": "Question",
    name: item.question || item.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: String(item.answer || item.content || "")
        .replace(/[#*_`]/g, "")
        .trim(),
    },
  }));

const faqPageSchema =
  mainEntity.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity,
      }
    : null;
---

{
  faqPageSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  )
}
