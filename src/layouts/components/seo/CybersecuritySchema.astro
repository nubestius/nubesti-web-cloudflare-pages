---
import { organizationJsonLd } from "@/lib/schema/organization";
import { COMPANY } from "@/lib/company";

const organizationSchema = organizationJsonLd();

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${COMPANY.website}#professionalService`,
  name: "Nubesti autonomous security testing",
  url: COMPANY.website,
  description:
    "Authorized, continuous offensive testing with evidence, remediation guidance, and retest. Paid KYC is required before tests launch.",
  provider: {
    "@type": "Organization",
    name: COMPANY.legalName,
    legalName: COMPANY.legalName,
  },
  address: organizationSchema.address,
};

const schemas = [organizationSchema, professionalServiceSchema];
---

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
