---
import { markdownify } from "@/lib/utils/textConverter";

const { class: className } = Astro.props;
let { enable, customer, content } = Astro.props.content || {};

const initials = (customer?.name || "")
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part[0])
  .join("")
  .toUpperCase();
---

{
  enable && (
    <div
      class:list={[
        "border-white/10 bg-white/[0.035] relative flex w-full rounded-3xl border p-6 md:p-7 " +
          className,
      ]}>
      <div class="flex flex-col justify-between gap-8">
        {content && (
          <div class="prose-styles text-[0.975rem] leading-relaxed opacity-90" set:html={markdownify(content, true)} />
        )}
        {customer && (
          <div class="flex items-center gap-3">
            <span
              class="border-white/10 bg-white/5 text-secondary inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border text-xs font-medium tracking-[0.08em]"
              aria-hidden="true">
              {initials}
            </span>
            <div>
              {customer.name && (
                <div class="text-light" set:html={markdownify(customer.name)} />
              )}
              {customer.role && (
                <p
                  class="text-sm opacity-60"
                  set:html={markdownify(customer.role)}
                />
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
