---
import Base from "@/layouts/Base.astro";
import { getLocaleUrlCTM } from "@/lib/utils/languageParser.ts";
import { markdownify } from "@/lib/utils/textConverter";
import { COMPANY } from "@/lib/company";
import { getTrustBundle, type TrustPageCopy } from "@/lib/trust";
import ContactChannels from "./ContactChannels.astro";

interface Props {
  page: TrustPageCopy;
  showChannels?: boolean;
  showSteps?: boolean;
}

const { page, showChannels = false, showSteps = false } = Astro.props;
const locale = Astro.currentLocale || "en";
const bundle = getTrustBundle(locale);
const homeUrl = getLocaleUrlCTM("/", locale);
---

<Base
  title={page.crumb}
  meta_title={page.meta_title}
  meta_description={page.meta_description}
  disable_tagline={true}
  sectionSpacing="md">
  <section class="legal-hub">
    <div class="container">
      <nav
        class="text-sm tracking-[0.16em] uppercase opacity-60"
        aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a class="hover:text-light hover:opacity-100" href={homeUrl}>
              {bundle.home}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-light opacity-100">{page.crumb}</li>
        </ol>
      </nav>

      <p class="text-secondary mt-10 text-sm font-medium tracking-[0.22em] uppercase">
        {page.eyebrow}
      </p>
      <h1 class="font-secondary text-light mt-4 max-w-4xl text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
        {page.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg opacity-80">{page.intro}</p>

      <div class="border-white/10 bg-white/[0.04] mt-10 inline-flex max-w-full flex-wrap items-center gap-x-3 gap-y-2 rounded-full border px-5 py-3 text-sm">
        <span class="text-light font-medium">{COMPANY.legalName}</span>
        <span class="opacity-40" aria-hidden="true">·</span>
        <span class="opacity-75">{COMPANY.jurisdiction}</span>
      </div>

      {
        showSteps && (
          <ol class="mt-16 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {bundle.howItWorks.steps.map((item) => (
              <li class="border-white/10 bg-white/[0.035] rounded-3xl border p-7">
                <p class="text-secondary text-xs tracking-[0.2em] uppercase">
                  {item.step}
                </p>
                <h2 class="font-secondary text-light mt-4 text-2xl">{item.title}</h2>
                <p class="mt-3 text-[0.975rem] leading-relaxed opacity-75">
                  {item.body}
                </p>
              </li>
            ))}
          </ol>
        )
      }

      <div class="legal-prose prose-styles mt-16 max-w-3xl space-y-14">
        {
          page.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              <div set:html={markdownify(section.body, true)} />
            </section>
          ))
        }
      </div>

      {showChannels && <ContactChannels class="mt-20" />}
      <slot />
    </div>
  </section>
</Base>
