# ===========================================
# Cloudflare Pages - Security Headers
# Nubesti Web - https://nubesti.com
# Updated: 2025-12-05
# ===========================================

# Global security headers for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; frame-src 'self' https://app.supademo.com https://www.youtube.com https://player.vimeo.com; child-src 'self' https://app.supademo.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://preline.co https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co https://formspree.io https://gmail.us11.list-manage.com; upgrade-insecure-requests;

# Static assets - Long cache (1 year, immutable)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/plyr/*
  Cache-Control: public, max-age=31536000, immutable

/__astro_font_generated__/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons - Long cache
/images/favicons/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker - No cache (always fresh)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Sitemap and robots - Short cache (1 day)
/sitemap*.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

# Security.txt - Short cache
/.well-known/*
  Cache-Control: public, max-age=86400
